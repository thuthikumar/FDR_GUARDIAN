APP_ENV=development
# For local development synthetic users only. Demo scripts use a temporary
# SEED_DEMO_PASSWORD set in the terminal, not this file.
DATABASE_URL=postgresql+psycopg://fdr_guardian:replace-with-local-password@127.0.0.1:5432/fdr_guardian
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
FRONTEND_ORIGIN=http://127.0.0.1:5173
COOKIE_SECURE=false
STORAGE_ROOT=./storage
# Optional when Tesseract is not available on PATH.
# TESSERACT_CMD=/usr/bin/tesseract
