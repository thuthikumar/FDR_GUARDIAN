# Copy this file to .env before starting the backend.
# PostgreSQL via the included Docker Compose service:
DATABASE_URL=postgresql+psycopg://fdr_guardian:replace-this-local-password@localhost:5432/fdr_guardian
TEST_DATABASE_URL=postgresql+psycopg://fdr_guardian:replace-this-local-password@localhost:5432/fdr_guardian_test

# PostgreSQL Compose defaults. Change these for local development if desired.
POSTGRES_DB=fdr_guardian
POSTGRES_USER=fdr_guardian
POSTGRES_PASSWORD=replace-this-local-password

# Authentication settings. Replace the JWT placeholder with a random value of 32+ characters.
APP_ENV=development
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_REUSE_GRACE_SECONDS=10
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://127.0.0.1:5173
# SEED_DEV_PASSWORD is only for local synthetic account passwords via
# python -m app.db.set_dev_passwords. Demo seed/rotation uses the session-only
# SEED_DEMO_PASSWORD variable; never add that variable or a Neon URL to this file.
SEED_DEV_PASSWORD=replace-with-a-strong-local-only-password

# Maturity monitoring: demo rules only. Scheduler remains opt-in.
APP_TIMEZONE=Asia/Kolkata
SCHEDULER_ENABLED=false
MONITORING_RUN_HOUR=2
MONITORING_RUN_MINUTE=0
STORAGE_ROOT=
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=10
MAX_DOCUMENTS_PER_FDR=20
OCR_ENABLED=true
TESSERACT_CMD=
OCR_LANGUAGES=eng
OCR_TIMEOUT_SECONDS=60
PROCESSING_STALE_MINUTES=15
